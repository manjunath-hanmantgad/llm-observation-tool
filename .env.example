# Runtime mode
# mock = deterministic local demo mode, no API key required
# openai = OpenAI API
# azure = Azure OpenAI
LLM_PROVIDER=mock
STORAGE_MODE=local
LLM_OBSERVATORY_DB_PATH=storage/metrics.db

# Primary application database
# Local default can use SQLite. Production should use PostgreSQL:
# postgresql+psycopg://observatory:change_me@postgres:5432/observatory
DATABASE_URL=sqlite:///storage/observatory.db

# Auth
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ISSUER=llm-observatory
JWT_ACCESS_TOKEN_MINUTES=30
API_KEY_PEPPER=replace_with_a_long_random_pepper
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8510

# OpenAI mode
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EVAL_MODEL=gpt-4o-mini

# Azure OpenAI mode, required only when LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EVAL_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Azure production placeholders
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
COSMOS_URL=
COSMOS_KEY=

# Alerts
SLACK_WEBHOOK_URL=
ALERT_HALLUCINATION_RATE_THRESHOLD=0.20
ALERT_AVG_LATENCY_MS_THRESHOLD=2500
